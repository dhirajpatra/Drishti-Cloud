# Where your Drishti server is (must be reachable from this site; use https:// on the internet)
GATEWAY_URL=https://drishti.example.com
TENANT_ID=home_1_bangalore
# Created once in the dashboard: Admin > Connect a camera > Pair a site. It can ONLY send pictures for this tenant.
EDGE_TOKEN=dre_replace_me
# camera_id=url, comma separated. The password stays on this machine.
CAMERAS=kitchen=rtsp://user:password@192.168.1.50:8081/,icu_bed5=http://192.168.1.51:80/picture/1/current/
INTERVAL_SEC=30        # a changed scene is sent at most this often
KEEPALIVE_SEC=120      # an unchanged scene is shown on the dashboard this often
POLL_SEC=10          # how often the camera is looked at (each look opens one short RTSP session)

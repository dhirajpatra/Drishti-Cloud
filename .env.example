# ===== Drishti Cloud configuration =====  cp .env.example .env
# Everything here is optional on a laptop: with no LLAMA_API_KEY the stack runs in MOCK_MODE.

# --- demo edge (remove this line in production so no synthetic frames are generated)
COMPOSE_PROFILES=sim

# --- Meta Model API (https://api.llama.com). Leave empty to run fully offline in MOCK_MODE.
LLAMA_API_KEY=
LLAMA_API_URL=https://api.llama.com/compat/v1/
LOW_COST_MODE=true
RTSP_FEEDS=rtsp://your-motioneye-pi-zero-ip:8765/picture/1/current/
# Model ids are what your Meta API account exposes - check them in the dashboard if a call 404s.
SAM_MODEL=Llama-SAM-3.1
SPARK_MODEL=Llama-4-Maverick
WONDER_MODEL=Llama-4-Behemoth
OCR_MODEL=Llama-4-Maverick
MOCK_MODE=auto                   # auto = on when LLAMA_API_KEY is empty | true | false
NEWS_API_KEY=                    # optional, newsapi.org

# --- cost control (target ~Rs 60/month API per home)
LOW_COST_MODE=true               # scene-hash dedupe, 30 s sampling, static-scene reuse, per-camera LLM gate
SAMPLE_INTERVAL_SEC=30
MAX_LLM_CALLS_PER_DAY=5000       # hard daily ceiling across all models; rules keep working past it

# --- feeds (optional): tenant:vertical:camera=url, comma separated. MP4 paths live under ./feeds
RTSP_FEEDS=

# --- security. LOCAL ONLY defaults. For any shared / cloud host:
#   AUTH_REQUIRED=true, set ADMIN_TOKEN (long random), change both passwords, BIND_ADDR=0.0.0.0 behind TLS
AUTH_REQUIRED=false
ADMIN_TOKEN=
BIND_ADDR=127.0.0.1
NEO4J_PASSWORD=drishti123
POSTGRES_PASSWORD=drishti123
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SEED_DEMO=true                   # creates 4 demo tenants (mall, home, school, ICU) on first start

# --- notifications: Slack-compatible incoming webhook for WhatsApp/call/nurse-station/admin messages
NOTIFY_WEBHOOK_URL=

# --- misc
TZ=Asia/Kolkata                  # habit windows and "night" are evaluated in this timezone
LOG_LEVEL=INFO
# Rule thresholds (defaults shown): UNATTENDED_BAG_SEC=120 NO_MOTION_SEC=7200 STAFF_ABSENT_SEC=3600
# CROWD_THRESHOLD=50 NIGHT_START_HOUR=22 NIGHT_END_HOUR=5 ALERT_COOLDOWN_SEC=300 MAX_FRAMES_PER_MIN=60

# ===== Drishti Cloud configuration =====  cp .env.example .env
# Everything here is optional on a laptop: with no LLAMA_API_KEY the stack runs in MOCK_MODE.

# --- demo edge (remove this line in production so no synthetic frames are generated)
# COMPOSE_PROFILES=sim

# --- Meta Model API (https://api.llama.com). Leave empty to run fully offline in MOCK_MODE.
LLAMA_API_KEY=same
MODEL_API_KEY=same
LLAMA_API_URL=https://api.meta.ai/v1/responses

# Model ids are what your Meta API account exposes - check them in the dashboard if a call 404s.
SAM_MODEL=sam-3.1
SPARK_MODEL=muse-spark-1.3
WONDER_MODEL=muse-wonder-1.0
IMAGE_MODEL=muse-image-1.0
OCR_MODEL=muse-spark-1.3
VOICE_MODEL=muse-voice-transcribe-1.0

MOCK_MODE=false                   # auto = on when LLAMA_API_KEY is empty | true | false
NEWS_API_KEY=                    # optional, newsapi.org

# --- cost control (target ~Rs 60/month API per home)
LOW_COST_MODE=true               # scene-hash dedupe, 30 s sampling, static-scene reuse, per-camera LLM gate
SIM_ALLOW_LIVE=true
SAMPLE_INTERVAL_SEC=120
MAX_LLM_CALLS_PER_DAY=5000       # hard daily ceiling across all models; rules keep working past it

# --- feeds (optional): tenant:vertical:camera=url, comma separated. MP4 paths live under ./feeds
RTSP_FEEDS=
# motionEye: use its *Streaming URL* (MJPEG, default port 8081 - motionEye > Video Streaming > Useful URLs), tagged tenant:vertical:camera.
# Also accepted: single-JPEG snapshot URLs, rtsp:// streams, MP4 files under ./feeds.
# RTSP_FEEDS=home_1_bangalore:home_seniors:kitchen=http://192.168.1.4:8081/
# (the tenant must already exist - the demo ones are mall_1, home_1_bangalore, school_1, icu_ward_1)

# --- security. LOCAL ONLY defaults. For any shared / cloud host:
#   AUTH_REQUIRED=true, set ADMIN_TOKEN (long random), change both passwords, BIND_ADDR=0.0.0.0 behind TLS
AUTH_REQUIRED=false
ADMIN_TOKEN=
BIND_ADDR=127.0.0.1
NEO4J_PASSWORD=drishti123
POSTGRES_PASSWORD=drishti123
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SEED_DEMO=true                   # creates 4 demo tenants (mall, home, school, ICU) on first start

# --- notifications: Slack-compatible incoming webhook for WhatsApp/call/nurse-station/admin messages
NOTIFY_WEBHOOK_URL=

# --- misc
TZ=Asia/Kolkata                  # habit windows and "night" are evaluated in this timezone
LOG_LEVEL=INFO
# Rule thresholds (defaults shown): UNATTENDED_BAG_SEC=120 NO_MOTION_SEC=7200 STAFF_ABSENT_SEC=3600
# CROWD_THRESHOLD=50 NIGHT_START_HOUR=22 NIGHT_END_HOUR=5 ALERT_COOLDOWN_SEC=300 MAX_FRAMES_PER_MIN=60

# --- Meta Responses API tuning
REASONING_EFFORT=low             # muse-* reason before answering: low|medium|high (high ate the whole 900-token budget)
REASONING_HEADROOM_TOKENS=2500   # extra output tokens reserved for thinking; one automatic retry at double if still cut off
SAM_MODE=auto                    # auto = try sam-3.1, switch to the Spark vision model for 1h if it returns no text | sam | spark

# --- simulator: with a real LLAMA_API_KEY (MOCK_MODE=false) the 'sim' profile pauses itself, because every synthetic
#     frame would be a paid model call. Remove COMPOSE_PROFILES=sim for real cameras. SIM_ALLOW_LIVE=true overrides.
# SIM_ALLOW_LIVE=false

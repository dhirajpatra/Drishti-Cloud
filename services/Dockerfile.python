# Shared Dockerfile for every Python service.
# Build context is ./services ; pick the service with --build-arg SERVICE=<dir>.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

ARG SERVICE
ARG SYSTEM_PACKAGES=""
RUN if [ -n "$SYSTEM_PACKAGES" ]; then \
      apt-get update && apt-get install -y --no-install-recommends $SYSTEM_PACKAGES \
      && rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /app
COPY common /opt/common
RUN pip install /opt/common

COPY ${SERVICE}/requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

RUN useradd --system --uid 10001 --no-create-home drishti
COPY ${SERVICE}/ /app/
USER drishti

CMD ["python", "-u", "main.py"]
